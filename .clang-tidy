# .clang-tidy — the checks worth failing a build over.
#
# Deliberately a short list rather than the whole catalogue. A analyser that
# reports three hundred style opinions gets switched off within a week, and
# then catches nothing at all; these are the families that map onto faults
# this project has actually shipped.
#
#   bugprone-unused-return-value  End Broadcast published nothing for six days
#                                 because put_bytes()'s result was discarded
#                                 and end() signed off regardless (BUGS.md).
#   concurrency-*                 Thirteen files here spawn threads.
#   clang-analyzer-*              Path-sensitive: null derefs, leaks, dead
#                                 stores across branches.
#   bugprone-*                    Use-after-move, dangling handles, sizeof
#                                 mistakes, misplaced widening casts.
#   performance-*                 Mostly needless copies. Cheap to honour.
#
# Excluded on purpose:
#   readability-*, modernize-*    Opinion, not correctness. The tree is
#                                 internally consistent already and churn
#                                 would bury the findings that matter.
#   *-magic-numbers               This code is full of deliberate constants
#                                 (ports, timeouts, segment counts), each
#                                 already explained in a comment beside it.
Checks: >
  bugprone-*,
  concurrency-*,
  clang-analyzer-*,
  performance-*,
  cert-err34-c,
  cert-flp30-c,
  misc-unused-using-decls,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone

# Only our own code. Findings in vendor/nlohmann or a system header are not
# ours to fix and would drown everything that is.
HeaderFilterRegex: '.*/src/(core|obs|appliance)/.*'

# Advisory to begin with. The point of the first run is to find out what is
# there; promoting individual checks to errors is a decision to make against
# a real list rather than in advance of one.
WarningsAsErrors: ''
